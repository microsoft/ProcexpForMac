<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Entitlements for the main ProcessExplorer app (W13 signing).

      This entitlement authorises the app to register/manage a launchd-managed
      daemon via SMAppService. Without it (or without Developer-ID signing)
      SMAppService.register() fails with the errors surfaced cleanly by
      PrivilegedDataProvider.installHelper() as ProviderError.helperUnavailable.
    -->
    <key>com.apple.developer.service-management.managed-by-launchd</key>
    <true/>
</dict>
</plist>
